{
  "name": "@melliatlas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/",
    "test:db": "vitest run integration/",
    "db:migrate": "tsx src/db/migrate.ts",
    "provider:seed": "tsx src/db/seedProvider.ts",
    "evidence:saturn": "node --import tsx src/modules/sources/providers/saturn/saturnCaptureCli.ts",
    "demo:seed": "tsx src/db/seedDemo.ts"
  },
  "dependencies": {
    "@melliatlas/contracts": "workspace:*",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.15.6",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.13",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
