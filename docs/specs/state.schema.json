{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MelliAtlas SDD state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "selectedWorkstreamId", "workstreams"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "const": "SINGLE" },
    "selectedWorkstreamId": { "type": "string", "minLength": 1 },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "specPath", "stageId", "phase"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "specPath": {
            "type": "string",
            "pattern": "^docs/specs/active/subspecs/[a-z0-9-]+\\.md$"
          },
          "stageId": { "type": "string", "pattern": "^[A-Z]+-[0-9]{2}$" },
          "phase": {
            "enum": [
              "DESIGN",
              "READY_FOR_IMPLEMENTATION",
              "READY_FOR_REVIEW",
              "AWAITING_DEVELOPER_DECISION",
              "BLOCKED",
              "PAUSED",
              "ON_HOLD"
            ]
          }
        }
      }
    }
  }
}
